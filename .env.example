# Vite reads VITE_* vars at build time.
# For local dev com Supabase local (supabase start), use:
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Production: defina VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY
# no painel da Vercel (Project Settings -> Environment Variables).
